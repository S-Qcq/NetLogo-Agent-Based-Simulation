    </chooser>
    <chooser x="150" y="415" height="60" variable="supply-distribution" current="1" width="135" display="supply-distribution">
      <choice type="string" value="concentrated"></choice>
      <choice type="string" value="even"></choice>
    </chooser>
    <button x="350" y="485" height="35" disableUntilTicks="false" forever="false" kind="Observer" width="66" display="setup">setup</button>
    <button x="480" y="485" height="35" disableUntilTicks="true" forever="false" kind="Observer" width="82" display="go-once">go</button>
    <button x="630" y="485" height="35" disableUntilTicks="true" forever="true" kind="Observer" width="64" display="go">go</button>
    <plot x="1375" autoPlotX="true" yMax="10.0" autoPlotY="true" y="5" xMin="0.0" height="290" legend="true" xMax="10.0" yMin="0.0" width="405" display="Items">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="supply" color="-13345367" legend="true">
        <setup></setup>
        <update>plot sum [items-for-sale] of sellers</update>
      </pen>
      <pen interval="1.0" mode="0" display="demand" color="-13840069" legend="true">
