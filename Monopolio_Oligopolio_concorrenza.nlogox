      </pen>
    </plot>
    <plot x="1375" autoPlotX="true" yMax="100.0" autoPlotY="true" y="300" xMin="0.0" height="235" legend="false" xMax="10.0" yMin="0.0" width="405" display="Buyer Willing-to-Pay (min, average, max)">
      <setup></setup>
      <update><![CDATA[let average-price mean [asking-price] of sellers
let top floor ifelse-value average-price = 0 [max [asking-price] of sellers] [average-price * 2]
set-plot-y-range 0 ifelse-value top < 1 [1] [top]]]></update>
      <pen interval="1.0" mode="0" display="avg-willing" color="-5825686" legend="true">
        <setup></setup>
